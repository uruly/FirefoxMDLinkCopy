{
  "manifest_version": 3,
  "name": "MDLinkCopy",
  "version": "0.1.0",
  "description": "Copy the current page as a Markdown link.",
  "permissions": ["activeTab", "clipboardWrite", "storage", "scripting"],
  "background": {
    "scripts": ["shared/defaults.js", "background.js"]
  },
  "action": {
    "default_title": "Copy as Markdown link",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current page as a Markdown link"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mdlinkcopy@example.com"
    }
  }
}
